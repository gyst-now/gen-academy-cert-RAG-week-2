# local starts in evidence-only mode if CHAT_MODEL is empty.
POLICY_STORE=local
POLICY_RERANK=0
# Coverage experiment options: hybrid, dense, dense_diverse, dense_split.
POLICY_RETRIEVAL_VARIANT=hybrid
# Set POLICY_STORE=supabase on Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Use a dedicated demo access code for hosted model requests.
DEMO_ACCESS_CODE=

# Set each base URL to your provider's OpenAI-compatible API root.
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=
EMBED_MODEL=
